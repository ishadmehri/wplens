{
  "name": "wplens",
  "version": "0.1.0",
  "description": "Fast WordPress stack profiler for freelancers and agencies - detect core, theme, plugins, host and more from the command line.",
  "type": "module",
  "bin": {
    "wplens": "./dist/index.js",
    "wpl": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/index.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wplens/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": ["wordpress", "cli", "recon", "fingerprint", "wp", "scanner", "plugins", "theme"],
  "engines": { "node": ">=20" },
  "license": "MIT"
}
